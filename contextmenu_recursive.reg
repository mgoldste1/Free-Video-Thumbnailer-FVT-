Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\Directory\shell\PS_Thumbnailer(R)]
@="Generate Thumbnails (recursive)"
"Extended"=""
"Icon"="C:\\video_encoders\\PS_Thumbnailer\\video.ico"

[HKEY_CLASSES_ROOT\Directory\shell\PS_Thumbnailer(R)\command]
@="\"C:\\Program Files\\PowerShell\\7\\pwsh.exe\" -NoLogo -NoProfile -ExecutionPolicy Bypass -File \"C:\\video_encoders\\PS_Thumbnailer\\thumbnails_recursive.ps1\" \"%1\""
